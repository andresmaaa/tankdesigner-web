@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{
                        var relative = Nav.ToBaseRelativePath(Nav.Uri).Trim('/').ToLowerInvariant();

                        if (relative != "login" &&
                        relative != "register" &&
                        relative != "forgot-password" &&
                        relative != "reset-password" &&
                        !relative.StartsWith("invitacion"))
                        {
                            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/" + relative)}", forceLoad: true);
                        }
                    }
                </NotAuthorized>
            </AuthorizeRouteView>

            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>