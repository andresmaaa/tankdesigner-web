@page "/instalacion"
@attribute [Authorize]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using TankDesigner.Core.Models
@using TankDesigner.Core.Services
@using TankDesigner.Web.Services
@using TankDesigner.Web.Data
@inject ProyectoState EstadoProyecto
@inject OpcionesFormularioService Opciones
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ProyectoPersistenciaService ProyectoPersistenciaService
@inject BrowserProyectoSnapshotService BrowserSnapshotService
@inject NavigationManager NavigationManager

<PageTitle>Instalación</PageTitle>

<div class="instalacion-page">
    <div class="page-header">
        <h1>Instalación</h1>
        <p>Configuración de montaje, accesos, conexiones, condiciones generales de obra y análisis opcional del emplazamiento del tanque.</p>
    </div>

    <EditForm Model="EstadoProyecto.Instalacion">
        <div class="page-layout">
            <section class="main-column">
                <article class="td-panel">
                    <div class="td-panel__header">
                        <div class="section-kicker">Bloque 01</div>
                        <h2>Elementos auxiliares</h2>
                        <p>Configuración de acceso y elementos principales de montaje.</p>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label>Tipo escalera</label>
                            <InputSelect class="td-input td-select" @bind-Value="EstadoProyecto.Instalacion.TipoEscalera">
                                @foreach (var item in _tiposEscalera)
                                {
                                    <option value="@item">@item</option>
                                }
                            </InputSelect>
                            <small>Solución de acceso prevista para el depósito.</small>
                        </div>

                        <div class="field">
                            <label>Número escaleras</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.NumeroEscaleras" />
                            <small>Cantidad total de escaleras necesarias en la instalación.</small>
                        </div>
                    </div>
                </article>

                <article class="td-panel">
                    <div class="td-panel__header">
                        <div class="section-kicker">Bloque 02</div>
                        <h2>Conexiones</h2>
                        <p>Distribución de conexiones por rangos de diámetro nominal.</p>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label>DN25 - DN150</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.ConexionesDN25_DN150" />
                            <small>Conexiones pequeñas y medias.</small>
                        </div>

                        <div class="field">
                            <label>DN150 - DN300</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.ConexionesDN150_DN300" />
                            <small>Conexiones de rango intermedio.</small>
                        </div>

                        <div class="field">
                            <label>DN300 - DN500</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.ConexionesDN300_DN500" />
                            <small>Conexiones de diámetro elevado.</small>
                        </div>

                        <div class="field">
                            <label>&gt; DN500</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.ConexionesMayorDN500" />
                            <small>Conexiones especiales o de gran diámetro.</small>
                        </div>
                    </div>
                </article>

                <article class="td-panel">
                    <div class="td-panel__header">
                        <div class="section-kicker">Bloque 03</div>
                        <h2>Condiciones de obra</h2>
                        <p>Parámetros de ejecución, equipo humano y características generales de obra.</p>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label>Tamaño cuadrilla</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.TamanoCuadrilla" />
                            <small>Número de operarios principales de montaje.</small>
                        </div>

                        <div class="field">
                            <label>Horas trabajo día (h/día)</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.HorasTrabajoDia" />
                            <small>Jornada prevista de trabajo diario en horas por día.</small>
                        </div>

                        <div class="field">
                            <label>Días lluvia (%)</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.DiasLluviaPorcentaje" />
                            <small>Porcentaje estimado de afección meteorológica.</small>
                        </div>

                        <div class="field">
                            <label>Site manager</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.SiteManager" />
                            <small>Responsables de supervisión en obra.</small>
                        </div>

                        <div class="field">
                            <label>Técnico seguridad</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.TecnicoSeguridad" />
                            <small>Recursos de seguridad y prevención.</small>
                        </div>

                        <div class="field">
                            <label>Lugar obra</label>
                            <InputSelect class="td-input td-select" @bind-Value="EstadoProyecto.Instalacion.LugarObra">
                                @foreach (var item in _lugaresObra)
                                {
                                    <option value="@item">@item</option>
                                }
                            </InputSelect>
                            <small>Clasificación general del emplazamiento de obra.</small>
                        </div>

                        <div class="field field--full">
                            <label>Distancia alojamiento - obra (h)</label>
                            <InputNumber class="td-input" @bind-Value="EstadoProyecto.Instalacion.DistanciaAlojamientoObra" />
                            <small>Tiempo estimado de desplazamiento entre alojamiento y obra, expresado en horas.</small>
                        </div>
                    </div>
                </article>

                <article class="td-panel td-panel--mapa">
                    <div class="td-panel__header td-panel__header--split">
                        <div>
                            <div class="section-kicker">Bloque 04 · opcional</div>
                            <h2>Ubicación y análisis de emplazamiento</h2>
                            <p>
                                Selección opcional de la ubicación real de obra. El mapa puede completar ciudad,
                                provincia y país automáticamente cuando sea posible. No modifica el cálculo estructural ni el presupuesto base.
                            </p>
                        </div>

                        <div class="map-actions">
                            <button type="button" class="td-btn td-btn--primary" @onclick="AbrirSelectorMapa">Abrir análisis</button>
                            <button type="button" class="td-btn td-btn--ghost" @onclick="LimpiarUbicacion">Limpiar</button>
                        </div>
                    </div>

                    <div class="professional-map-layout">
                        <div class="mini-map-shell">
                            <div id="emplazamientoMiniMap" class="mini-map"></div>
                            <div class="map-badge">OpenStreetMap</div>
                        </div>

                        <div class="location-panel location-panel--pro">
                            @if (!TieneEmplazamiento)
                            {
                                <div class="empty-location empty-location--pro">
                                    <strong>Emplazamiento pendiente de completar</strong>
                                    <span>Puedes dejarlo vacío. Este bloque solo añade contexto, trazabilidad y recomendaciones al informe.</span>
                                    <button type="button" class="td-btn td-btn--primary td-btn--inline" @onclick="AbrirSelectorMapa">Seleccionar ubicación</button>
                                </div>
                            }
                            else
                            {
                                <div class="location-headline">
                                    <div>
                                        <span class="location-eyebrow">Ubicación seleccionada</span>
                                        <h3>@TextoUbicacion()</h3>
                                        <p>@TextoDireccionResumen()</p>
                                    </div>
                                    <div class="score-pill @ClaseScore()">
                                        <span>Índice instalación</span>
                                        <strong>@TextoPuntuacion()</strong>
                                    </div>
                                </div>

                                <div class="location-meta-grid">
                                    <div><span>Ciudad</span><strong>@TextoSeguro(Emplazamiento.Ciudad)</strong></div>
                                    <div><span>Provincia</span><strong>@TextoSeguro(Emplazamiento.Provincia)</strong></div>
                                    <div><span>País</span><strong>@TextoSeguro(Emplazamiento.Pais)</strong></div>
                                    <div><span>Coordenadas</span><strong>@TextoCoordenadasCorto()</strong></div>
                                </div>

                                <div class="location-tags">
                                    @foreach (var tag in EtiquetasEmplazamiento())
                                    {
                                        <span>@tag</span>
                                    }
                                </div>
                            }

                            <div class="risk-grid risk-grid--pro">
                                <div class="risk-card @ClaseRiesgo(_analisis.RiesgoViento)">
                                    <span>Viento</span>
                                    <strong>@_analisis.RiesgoViento</strong>
                                </div>
                                <div class="risk-card @ClaseRiesgo(_analisis.RiesgoCorrosion)">
                                    <span>Corrosión</span>
                                    <strong>@_analisis.RiesgoCorrosion</strong>
                                </div>
                                <div class="risk-card @ClaseRiesgo(_analisis.DificultadMontaje)">
                                    <span>Montaje</span>
                                    <strong>@_analisis.DificultadMontaje</strong>
                                </div>
                                <div class="risk-card @ClaseRiesgo(_analisis.ImpactoTransporte)">
                                    <span>Transporte</span>
                                    <strong>@_analisis.ImpactoTransporte</strong>
                                </div>
                            </div>

                            <div class="recommendation-box recommendation-box--pro">
                                <strong>Resumen automático</strong>
                                <p>@_analisis.ResumenProfesional</p>
                            </div>

                            @if (_analisis.AccionesRecomendadas.Count > 0 && TieneEmplazamiento)
                            {
                                <div class="action-strip">
                                    <span>Acción recomendada</span>
                                    <strong>@_analisis.AccionesRecomendadas.First()</strong>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            </section>

            <aside class="side-column">
                <article class="td-panel td-panel--compact td-panel--sticky">
                    <div class="td-panel__header">
                        <div class="section-kicker">Resumen vivo</div>
                        <h2>Resumen de instalación</h2>
                        <p>Vista rápida de la configuración activa de montaje y obra.</p>
                    </div>

                    <div class="summary-list">
                        <div class="summary-row">
                            <span class="summary-row__label">Tipo escalera</span>
                            <span class="summary-row__value">@TextoSeguro(EstadoProyecto.Instalacion.TipoEscalera)</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Número escaleras</span>
                            <span class="summary-row__value">@EstadoProyecto.Instalacion.NumeroEscaleras</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Lugar obra</span>
                            <span class="summary-row__value">@TextoSeguro(EstadoProyecto.Instalacion.LugarObra)</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Cuadrilla</span>
                            <span class="summary-row__value">@EstadoProyecto.Instalacion.TamanoCuadrilla</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Horas día (h/día)</span>
                            <span class="summary-row__value">@EstadoProyecto.Instalacion.HorasTrabajoDia</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Días lluvia (%)</span>
                            <span class="summary-row__value">@EstadoProyecto.Instalacion.DiasLluviaPorcentaje</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Alojamiento - obra (h)</span>
                            <span class="summary-row__value">@EstadoProyecto.Instalacion.DistanciaAlojamientoObra</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Ubicación</span>
                            <span class="summary-row__value">@(TieneEmplazamiento? TextoUbicacion() : "Opcional sin completar")</span>
                        </div>

                        <div class="summary-row">
                            <span class="summary-row__label">Complejidad emplazamiento</span>
                            <span class="summary-row__value @ClaseResumenRiesgo()">@ResumenRiesgos()</span>
                        </div>
                    </div>
                </article>
            </aside>
        </div>
    </EditForm>
</div>

@if (_mostrarSelectorMapa)
{
    <div class="map-modal-overlay" @onclick="CerrarSelectorMapa"></div>

    <section class="map-modal map-modal--pro" @onclick:stopPropagation="true">
        <div class="map-modal__header">
            <div>
                <div class="section-kicker">Análisis de emplazamiento</div>
                <h2>Seleccionar ubicación de instalación</h2>
                <p>Busca una ciudad o haz clic en el mapa. Si el servicio de mapas no responde, puedes rellenar los campos manualmente.</p>
            </div>
            <button type="button" class="map-modal__close" @onclick="CerrarSelectorMapa">×</button>
        </div>

        <div class="map-modal__body map-modal__body--pro">
            <div class="map-workspace">
                <div class="map-search-card">
                    <label>Buscar ubicación</label>
                    <div class="map-search-row">
                        <InputText class="td-input" @bind-Value="_busquedaUbicacion" placeholder="Ejemplo: Ciudad Real, España" />
                        <button type="button" class="td-btn td-btn--primary" @onclick="BuscarUbicacionAsync">Buscar</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_mensajeMapa))
                    {
                        <div class="map-message">@_mensajeMapa</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_mensajePersistencia))
                    {
                        <div class="map-message map-message--save">@_mensajePersistencia</div>
                    }
                </div>

                <div class="large-map-shell large-map-shell--pro">
                    <div id="emplazamientoLargeMap" class="large-map"></div>
                </div>

                <div class="map-info-card">
                    <div>
                        <span>Coordenadas</span>
                        <strong>@TextoCoordenadas()</strong>
                    </div>
                    <div>
                        <span>Fuente</span>
                        <strong>@TextoSeguro(Emplazamiento.FuenteDatos)</strong>
                    </div>
                    <div>
                        <span>Dirección detectada</span>
                        <strong>@TextoDireccionResumen()</strong>
                    </div>
                </div>
            </div>

            <div class="map-form-panel map-form-panel--pro">
                <div class="form-grid form-grid--compact">
                    <div class="field field--full">
                        <label>Nombre ubicación / obra</label>
                        <InputText class="td-input" @bind-Value="Emplazamiento.NombreUbicacion" />
                        <small>Ejemplo: Planta industrial Ciudad Real, parcela cliente, obra norte...</small>
                    </div>

                    <div class="field">
                        <label>Ciudad</label>
                        <InputText class="td-input" @bind-Value="Emplazamiento.Ciudad" />
                    </div>

                    <div class="field">
                        <label>Provincia</label>
                        <InputText class="td-input" @bind-Value="Emplazamiento.Provincia" />
                    </div>

                    <div class="field">
                        <label>País</label>
                        <InputText class="td-input" @bind-Value="Emplazamiento.Pais" />
                    </div>

                    <div class="field">
                        <label>Código postal</label>
                        <InputText class="td-input" @bind-Value="Emplazamiento.CodigoPostal" />
                    </div>

                    <div class="field">
                        <label>Latitud</label>
                        <InputNumber class="td-input" @bind-Value="Emplazamiento.Latitud" />
                    </div>

                    <div class="field">
                        <label>Longitud</label>
                        <InputNumber class="td-input" @bind-Value="Emplazamiento.Longitud" />
                    </div>

                    <div class="field">
                        <label>Tipo de entorno</label>
                        <InputSelect class="td-input td-select" @bind-Value="Emplazamiento.TipoEntorno">
                            @foreach (var item in _tiposEntorno)
                            {
                                <option value="@item">@(string.IsNullOrWhiteSpace(item) ? "Sin indicar" : item)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label>Exposición al viento</label>
                        <InputSelect class="td-input td-select" @bind-Value="Emplazamiento.ExposicionViento">
                            @foreach (var item in _exposicionesViento)
                            {
                                <option value="@item">@(string.IsNullOrWhiteSpace(item) ? "Sin indicar" : item)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label>Acceso a obra</label>
                        <InputSelect class="td-input td-select" @bind-Value="Emplazamiento.AccesoObra">
                            @foreach (var item in _accesosObra)
                            {
                                <option value="@item">@(string.IsNullOrWhiteSpace(item) ? "Sin indicar" : item)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label>Tipo de terreno</label>
                        <InputSelect class="td-input td-select" @bind-Value="Emplazamiento.TipoTerreno">
                            @foreach (var item in _tiposTerreno)
                            {
                                <option value="@item">@(string.IsNullOrWhiteSpace(item) ? "Sin indicar" : item)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field field--full">
                        <label>Ambiente</label>
                        <InputSelect class="td-input td-select" @bind-Value="Emplazamiento.Ambiente">
                            @foreach (var item in _ambientes)
                            {
                                <option value="@item">@(string.IsNullOrWhiteSpace(item) ? "Sin indicar" : item)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="field field--full">
                        <label>Observaciones de instalación</label>
                        <InputTextArea class="td-input" @bind-Value="Emplazamiento.ObservacionesInstalacion" />
                        <small>Notas internas: acceso limitado, necesidad de grúa, zona de acopio, permisos, etc.</small>
                    </div>
                </div>

                <div class="modal-analysis modal-analysis--pro">
                    <div class="analysis-header">
                        <div>
                            <span>Complejidad global</span>
                            <strong>@_analisis.ComplejidadGlobal</strong>
                        </div>
                        <div class="score-pill @ClaseScore()">
                            <span>Índice</span>
                            <strong>@TextoPuntuacion()</strong>
                        </div>
                    </div>

                    <div class="risk-grid risk-grid--modal">
                        <div class="risk-card @ClaseRiesgo(_analisis.RiesgoViento)">
                            <span>Viento</span>
                            <strong>@_analisis.RiesgoViento</strong>
                        </div>
                        <div class="risk-card @ClaseRiesgo(_analisis.RiesgoCorrosion)">
                            <span>Corrosión</span>
                            <strong>@_analisis.RiesgoCorrosion</strong>
                        </div>
                        <div class="risk-card @ClaseRiesgo(_analisis.DificultadMontaje)">
                            <span>Montaje</span>
                            <strong>@_analisis.DificultadMontaje</strong>
                        </div>
                    </div>

                    <div class="recommendation-box">
                        <strong>Resumen para informe</strong>
                        <p>@_analisis.ResumenProfesional</p>
                    </div>

                    <div class="analysis-columns">
                        <div>
                            <h4>Factores detectados</h4>
                            <ul class="recommendation-list">
                                @foreach (var factor in _analisis.FactoresDetectados)
                                {
                                    <li>@factor</li>
                                }
                            </ul>
                        </div>
                        <div>
                            <h4>Acciones recomendadas</h4>
                            <ul class="recommendation-list">
                                @foreach (var accion in _analisis.AccionesRecomendadas)
                                {
                                    <li>@accion</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="modal-actions">
                    <button type="button" class="td-btn td-btn--ghost" @onclick="ActualizarMarcadorManual">Actualizar marcador</button>
                    <button type="button" class="td-btn td-btn--primary" @onclick="GuardarUbicacion" disabled="@_guardandoUbicacion">@(_guardandoUbicacion ? "Guardando..." : "Guardar ubicación")</button>
                </div>
            </div>
        </div>
    </section>
}

@code {
    private const string MiniMapId = "emplazamientoMiniMap";
    private const string LargeMapId = "emplazamientoLargeMap";

    private readonly AnalisisEmplazamientoService _analisisService = new();
    private DotNetObjectReference<Instalacion>? _dotNetRef;

    private List<string> _tiposEscalera = new();
    private List<string> _lugaresObra = new();

    private readonly List<string> _tiposEntorno = new() { "", "Urbano", "Industrial", "Rural", "Costero" };
    private readonly List<string> _exposicionesViento = new() { "", "Protegida", "Normal", "Abierta", "Muy expuesta" };
    private readonly List<string> _accesosObra = new() { "", "Bueno", "Medio", "Difícil" };
    private readonly List<string> _tiposTerreno = new() { "", "Normal", "Irregular", "Blando", "Elevado" };
    private readonly List<string> _ambientes = new() { "", "Interior seco", "Exterior normal", "Costero/corrosivo", "Industrial agresivo" };

    private bool _mostrarSelectorMapa;
    private bool _miniMapaInicializado;
    private bool _mapaGrandeInicializado;
    private string _busquedaUbicacion = string.Empty;
    private string _mensajeMapa = string.Empty;
    private string _mensajePersistencia = string.Empty;
    private bool _guardandoUbicacion;
    private AnalisisEmplazamientoResultadoModel _analisis = new();

    private EmplazamientoInstalacionModel Emplazamiento => EstadoProyecto.Instalacion.Emplazamiento;
    private bool TieneEmplazamiento => Emplazamiento.TieneDatos;

    protected override void OnInitialized()
    {
        EstadoProyecto.OnChange += OnEstadoProyectoChanged;

        EstadoProyecto.Instalacion ??= new InstalacionModel();
        EstadoProyecto.Instalacion.Emplazamiento ??= new EmplazamientoInstalacionModel();

        _tiposEscalera = Opciones.ObtenerTiposEscalera();
        _lugaresObra = Opciones.ObtenerLugaresObra();

        if (string.IsNullOrWhiteSpace(EstadoProyecto.Instalacion.TipoEscalera))
            EstadoProyecto.Instalacion.TipoEscalera = "Sin escalera";

        if (string.IsNullOrWhiteSpace(EstadoProyecto.Instalacion.LugarObra))
            EstadoProyecto.Instalacion.LugarObra = "Nacional";

        if (EstadoProyecto.Instalacion.TamanoCuadrilla <= 0)
            EstadoProyecto.Instalacion.TamanoCuadrilla = 4;

        if (EstadoProyecto.Instalacion.HorasTrabajoDia <= 0)
            EstadoProyecto.Instalacion.HorasTrabajoDia = 8;

        if (EstadoProyecto.Instalacion.DiasLluviaPorcentaje <= 0)
            EstadoProyecto.Instalacion.DiasLluviaPorcentaje = 10;

        if (EstadoProyecto.Instalacion.SiteManager <= 0)
            EstadoProyecto.Instalacion.SiteManager = 1;

        if (EstadoProyecto.Instalacion.TecnicoSeguridad <= 0)
            EstadoProyecto.Instalacion.TecnicoSeguridad = 1;

        RecalcularAnalisis();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Importante: no inicializamos el mini mapa solo en firstRender.
        // Al refrescar, MainLayout restaura el proyecto desde localStorage unos instantes después
        // y la página se vuelve a pintar. Si el mapa se creó antes de tener tamaño real o antes de
        // recuperar las coordenadas, Leaflet puede quedarse en blanco. Por eso lo reintentamos
        // siempre que esté marcado como no inicializado.
        if (!_miniMapaInicializado)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _miniMapaInicializado = true;
            await InicializarMapaAsync(MiniMapId, false);
            await ActualizarMarcadoresMapaAsync();
        }

        if (_mostrarSelectorMapa && !_mapaGrandeInicializado)
        {
            _mapaGrandeInicializado = true;
            await InicializarMapaAsync(LargeMapId, true);
            await ActualizarMarcadoresMapaAsync();
        }
    }

    private async void OnEstadoProyectoChanged()
    {
        await InvokeAsync(async () =>
        {
            EstadoProyecto.Instalacion ??= new InstalacionModel();
            EstadoProyecto.Instalacion.Emplazamiento ??= new EmplazamientoInstalacionModel();
            RecalcularAnalisis();

            // Si el estado se ha restaurado después de un F5, forzamos una recreación limpia
            // del mapa. Esto evita el mapa gris/blanco cuando Leaflet se inicializa antes de que
            // el contenedor tenga tamaño definitivo.
            _miniMapaInicializado = false;
            _mapaGrandeInicializado = false;
            try
            {
                await JS.InvokeVoidAsync("tankDesignerMaps.destroy", MiniMapId);
                await JS.InvokeVoidAsync("tankDesignerMaps.destroy", LargeMapId);
            }
            catch
            {
            }

            StateHasChanged();
        });
    }

    private async Task ActualizarMarcadoresMapaAsync()
    {
        if (!Emplazamiento.Latitud.HasValue || !Emplazamiento.Longitud.HasValue)
            return;

        try
        {
            if (_miniMapaInicializado)
                await JS.InvokeVoidAsync("tankDesignerMaps.setMarker", MiniMapId, Emplazamiento.Latitud.Value, Emplazamiento.Longitud.Value, 12);

            if (_mapaGrandeInicializado)
                await JS.InvokeVoidAsync("tankDesignerMaps.setMarker", LargeMapId, Emplazamiento.Latitud.Value, Emplazamiento.Longitud.Value, 13);
        }
        catch
        {
            // Si el mapa no está disponible, mantenemos los datos manuales sin bloquear la pantalla.
        }
    }

    private async Task InicializarMapaAsync(string id, bool interactivo)
    {
        double lat = Emplazamiento.Latitud ?? 40.4168;
        double lng = Emplazamiento.Longitud ?? -3.7038;
        int zoom = Emplazamiento.Latitud.HasValue && Emplazamiento.Longitud.HasValue ? 12 : 6;

        try
        {
            await JS.InvokeVoidAsync("tankDesignerMaps.init", id, new
            {
                lat,
                lng,
                zoom,
                interactive = interactivo,
                dotNetRef = interactivo ? _dotNetRef : null
            });
        }
        catch
        {
            _mensajeMapa = "No se ha podido cargar el mapa. Puedes introducir los datos manualmente.";
        }
    }

    private async Task AbrirSelectorMapa()
    {
        _mostrarSelectorMapa = true;
        _mapaGrandeInicializado = false;
        _mensajeMapa = string.Empty;
        RecalcularAnalisis();
        await Task.CompletedTask;
    }

    private async Task CerrarSelectorMapa()
    {
        _mostrarSelectorMapa = false;
        _mapaGrandeInicializado = false;

        try
        {
            await JS.InvokeVoidAsync("tankDesignerMaps.destroy", LargeMapId);
        }
        catch
        {
        }
    }

    private async Task BuscarUbicacionAsync()
    {
        _mensajeMapa = string.Empty;

        if (string.IsNullOrWhiteSpace(_busquedaUbicacion))
        {
            _mensajeMapa = "Escribe una ciudad, provincia o dirección para buscar.";
            return;
        }

        try
        {
            var resultado = await JS.InvokeAsync<UbicacionMapaDto?>("tankDesignerMaps.searchLocation", LargeMapId, _busquedaUbicacion);

            if (resultado == null)
            {
                _mensajeMapa = "No se ha encontrado ninguna ubicación. Prueba con una búsqueda más concreta.";
                return;
            }

            AplicarUbicacion(resultado);
            _mensajeMapa = "Ubicación detectada y campos completados automáticamente.";
        }
        catch
        {
            _mensajeMapa = "No se ha podido buscar la ubicación. Puedes rellenar los campos manualmente.";
        }
    }

    private async Task GuardarUbicacion()
    {
        if (_guardandoUbicacion)
            return;

        _guardandoUbicacion = true;
        _mensajePersistencia = string.Empty;

        try
        {
            Emplazamiento.UbicacionSeleccionada = Emplazamiento.TieneDatos;
            RecalcularAnalisis();

            var guardado = await GuardarProyectoActualAsync();
            await ActualizarMiniMapaAsync();
            await CerrarSelectorMapa();

            _mensajePersistencia = guardado
                ? "Ubicación guardada en este proyecto. Al cambiar de proyecto o recargar la página se conservará."
                : "Ubicación aplicada temporalmente. Para guardarla definitivamente, inicia sesión y abre un proyecto guardado.";
        }
        finally
        {
            _guardandoUbicacion = false;
        }
    }

    private async Task LimpiarUbicacion()
    {
        if (_guardandoUbicacion)
            return;

        _guardandoUbicacion = true;
        _mensajePersistencia = string.Empty;

        try
        {
            EstadoProyecto.Instalacion.Emplazamiento = new EmplazamientoInstalacionModel();
            _busquedaUbicacion = string.Empty;
            _mensajeMapa = string.Empty;
            RecalcularAnalisis();
            await ActualizarMiniMapaAsync();

            var guardado = await GuardarProyectoActualAsync();
            _mensajePersistencia = guardado
                ? "Ubicación eliminada y cambio guardado en este proyecto."
                : "Ubicación eliminada temporalmente. Guarda el proyecto para conservar el cambio.";
        }
        finally
        {
            _guardandoUbicacion = false;
        }
    }

    private async Task<bool> GuardarProyectoActualAsync()
    {
        try
        {
            EstadoProyecto.Proyecto ??= new ProyectoGeneralModel();
            EstadoProyecto.Tanque ??= new TankModel();
            EstadoProyecto.Cargas ??= new CargasModel();
            EstadoProyecto.Instalacion ??= new InstalacionModel();
            EstadoProyecto.Instalacion.Emplazamiento ??= new EmplazamientoInstalacionModel();
            EstadoProyecto.Resultado ??= new ResultadoCalculoModel();

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var usuario = await UserManager.GetUserAsync(authState.User);

            if (usuario == null)
            {
                await BrowserSnapshotService.GuardarAsync(
                    EstadoProyecto,
                    UsuarioSnapshotKey(authState.User),
                    NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

                EstadoProyecto.NotificarCambio();
                return false;
            }

            var id = await ProyectoPersistenciaService.GuardarAsync(
                usuario.Id,
                EstadoProyecto.ProyectoIdActual,
                EstadoProyecto.Proyecto,
                EstadoProyecto.Tanque,
                EstadoProyecto.Cargas,
                EstadoProyecto.Instalacion,
                EstadoProyecto.Resultado);

            EstadoProyecto.ProyectoIdActual = id;

            await BrowserSnapshotService.GuardarAsync(
                EstadoProyecto,
                UsuarioSnapshotKey(authState.User),
                NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

            EstadoProyecto.NotificarCambio();
            return true;
        }
        catch (Exception ex)
        {
            _mensajePersistencia = $"No se ha podido guardar la ubicación en base de datos: {ex.Message}";
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                await BrowserSnapshotService.GuardarAsync(
                    EstadoProyecto,
                    UsuarioSnapshotKey(authState.User),
                    NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
            }
            catch
            {
            }

            EstadoProyecto.NotificarCambio();
            return false;
        }
    }

    private static string UsuarioSnapshotKey(System.Security.Claims.ClaimsPrincipal? usuario)
    {
        if (usuario is null)
            return "anonimo";

        return usuario.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? usuario.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? usuario.Identity?.Name
            ?? "anonimo";
    }

    private async Task ActualizarMiniMapaAsync()
    {
        try
        {
            if (Emplazamiento.Latitud.HasValue && Emplazamiento.Longitud.HasValue)
            {
                await JS.InvokeVoidAsync("tankDesignerMaps.setMarker", MiniMapId, Emplazamiento.Latitud.Value, Emplazamiento.Longitud.Value, 12);
            }
            else
            {
                await JS.InvokeVoidAsync("tankDesignerMaps.setMarker", MiniMapId, 40.4168, -3.7038, 6);
            }
        }
        catch
        {
        }
    }

    private async Task ActualizarMarcadorManual()
    {
        Emplazamiento.UbicacionSeleccionada = Emplazamiento.TieneDatos;
        RecalcularAnalisis();

        if (Emplazamiento.Latitud.HasValue && Emplazamiento.Longitud.HasValue)
        {
            try
            {
                await JS.InvokeVoidAsync("tankDesignerMaps.setMarker", LargeMapId, Emplazamiento.Latitud.Value, Emplazamiento.Longitud.Value, 13);
                _mensajeMapa = "Marcador actualizado con las coordenadas manuales.";
            }
            catch
            {
                _mensajeMapa = "No se ha podido mover el marcador. Los datos manuales se conservarán.";
            }
        }
    }

    [JSInvokable]
    public void ActualizarUbicacionDesdeMapa(UbicacionMapaDto ubicacion)
    {
        AplicarUbicacion(ubicacion);
        _mensajeMapa = "Ubicación detectada desde el mapa.";
        StateHasChanged();
    }

    private void AplicarUbicacion(UbicacionMapaDto? ubicacion)
    {
        if (ubicacion == null)
            return;

        Emplazamiento.Latitud = Math.Round(ubicacion.Latitud, 6);
        Emplazamiento.Longitud = Math.Round(ubicacion.Longitud, 6);
        Emplazamiento.UbicacionSeleccionada = true;

        if (!string.IsNullOrWhiteSpace(ubicacion.NombreUbicacion))
            Emplazamiento.NombreUbicacion = ubicacion.NombreUbicacion.Trim();

        if (!string.IsNullOrWhiteSpace(ubicacion.Ciudad))
            Emplazamiento.Ciudad = ubicacion.Ciudad.Trim();

        if (!string.IsNullOrWhiteSpace(ubicacion.Provincia))
            Emplazamiento.Provincia = ubicacion.Provincia.Trim();

        if (!string.IsNullOrWhiteSpace(ubicacion.Pais))
            Emplazamiento.Pais = ubicacion.Pais.Trim();

        if (!string.IsNullOrWhiteSpace(ubicacion.CodigoPostal))
            Emplazamiento.CodigoPostal = ubicacion.CodigoPostal.Trim();

        if (!string.IsNullOrWhiteSpace(ubicacion.DireccionResumen))
            Emplazamiento.DireccionResumen = ubicacion.DireccionResumen.Trim();

        if (!string.IsNullOrWhiteSpace(ubicacion.FuenteDatos))
            Emplazamiento.FuenteDatos = ubicacion.FuenteDatos.Trim();

        if (!string.IsNullOrWhiteSpace(ubicacion.FechaConsulta))
            Emplazamiento.FechaConsulta = ubicacion.FechaConsulta.Trim();

        RecalcularAnalisis();
    }

    private void RecalcularAnalisis()
    {
        _analisis = _analisisService.Analizar(Emplazamiento);
    }

    private string TextoSeguro(string? texto)
    {
        return string.IsNullOrWhiteSpace(texto) ? "—" : texto.Trim();
    }

    private string TextoUbicacion()
    {
        if (!string.IsNullOrWhiteSpace(Emplazamiento.NombreUbicacion))
            return Emplazamiento.NombreUbicacion.Trim();

        var partes = new[] { Emplazamiento.Ciudad, Emplazamiento.Provincia, Emplazamiento.Pais }
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .ToList();

        return partes.Count > 0 ? string.Join(", ", partes) : "Ubicación sin nombre";
    }

    private string TextoDireccionResumen()
    {
        if (!string.IsNullOrWhiteSpace(Emplazamiento.DireccionResumen))
            return Emplazamiento.DireccionResumen.Trim();

        return TieneEmplazamiento ? TextoCoordenadas() : "Sin datos de dirección";
    }

    private string TextoCoordenadas()
    {
        if (!Emplazamiento.Latitud.HasValue || !Emplazamiento.Longitud.HasValue)
            return "Coordenadas sin indicar";

        return $"Lat. {Emplazamiento.Latitud.Value:0.######} · Long. {Emplazamiento.Longitud.Value:0.######}";
    }

    private string TextoCoordenadasCorto()
    {
        if (!Emplazamiento.Latitud.HasValue || !Emplazamiento.Longitud.HasValue)
            return "—";

        return $"{Emplazamiento.Latitud.Value:0.####}, {Emplazamiento.Longitud.Value:0.####}";
    }

    private string TextoPuntuacion()
    {
        return TieneEmplazamiento ? $"{_analisis.PuntuacionInstalacion}/100" : "—";
    }

    private IEnumerable<string> EtiquetasEmplazamiento()
    {
        if (!string.IsNullOrWhiteSpace(Emplazamiento.TipoEntorno))
            yield return Emplazamiento.TipoEntorno;

        if (!string.IsNullOrWhiteSpace(Emplazamiento.ExposicionViento))
            yield return $"Viento: {Emplazamiento.ExposicionViento}";

        if (!string.IsNullOrWhiteSpace(Emplazamiento.AccesoObra))
            yield return $"Acceso: {Emplazamiento.AccesoObra}";

        if (!string.IsNullOrWhiteSpace(Emplazamiento.TipoTerreno))
            yield return $"Terreno: {Emplazamiento.TipoTerreno}";

        if (!string.IsNullOrWhiteSpace(Emplazamiento.Ambiente))
            yield return Emplazamiento.Ambiente;
    }

    private string ClaseRiesgo(string? valor)
    {
        string texto = (valor ?? string.Empty).Trim().ToLowerInvariant();

        if (texto == "alto" || texto == "alta")
            return "risk-card--high";

        if (texto == "medio" || texto == "media")
            return "risk-card--medium";

        if (texto == "bajo" || texto == "baja")
            return "risk-card--low";

        return "risk-card--empty";
    }

    private string ClaseScore()
    {
        if (!TieneEmplazamiento)
            return "score-pill--empty";

        if (_analisis.PuntuacionInstalacion >= 82)
            return "score-pill--low";

        if (_analisis.PuntuacionInstalacion >= 58)
            return "score-pill--medium";

        return "score-pill--high";
    }

    private string ResumenRiesgos()
    {
        if (!TieneEmplazamiento)
            return "No evaluado";

        return $"{_analisis.ComplejidadGlobal} · {_analisis.PuntuacionInstalacion}/100";
    }

    private string ClaseResumenRiesgo()
    {
        if (_analisis.ComplejidadGlobal == "Alta")
            return "summary-value-warn";

        if (_analisis.ComplejidadGlobal == "Baja")
            return "summary-value-ok";

        return string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        EstadoProyecto.OnChange -= OnEstadoProyectoChanged;

        try
        {
            await JS.InvokeVoidAsync("tankDesignerMaps.destroy", MiniMapId);
            await JS.InvokeVoidAsync("tankDesignerMaps.destroy", LargeMapId);
        }
        catch
        {
        }

        _dotNetRef?.Dispose();
    }

    public class UbicacionMapaDto
    {
        public double Latitud { get; set; }
        public double Longitud { get; set; }
        public string NombreUbicacion { get; set; } = string.Empty;
        public string Ciudad { get; set; } = string.Empty;
        public string Provincia { get; set; } = string.Empty;
        public string Pais { get; set; } = string.Empty;
        public string CodigoPostal { get; set; } = string.Empty;
        public string DireccionResumen { get; set; } = string.Empty;
        public string FuenteDatos { get; set; } = string.Empty;
        public string FechaConsulta { get; set; } = string.Empty;
    }
}
