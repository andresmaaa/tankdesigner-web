@using TankDesigner.Core.Models
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="tank3d-card">
    <div class="tank3d-card__header">
        <div>
            <div class="section-kicker">Visualización 3D</div>
            <h2>Modelo tridimensional del tanque</h2>
            <p>
                Vista generada desde el resultado real del cálculo: diámetro, altura total,
                starter ring, anillos, espesores, materiales, configuración, rigidizador,
                techo aplicado, vigas radiales y escaleras.
            </p>
        </div>

        <button type="button" class="td-btn td-btn--primary td-btn--with-icon" @onclick="ActualizarVista3D">
            <span class="td-btn__icon">⟳</span>
            <span>Actualizar vista</span>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="tank3d-warning">@_mensaje</div>
    }

    <div class="tank3d-layout">
        <div class="tank3d-viewport" @ref="_contenedor3d"></div>

        <div class="tank3d-info">
            <div class="tank3d-info__title">Datos usados</div>

            <div class="tank3d-info__row">
                <span>Diámetro</span>
                <strong>@FormatoMetros(Resultado?.Diametro) m</strong>
            </div>

            <div class="tank3d-info__row">
                <span>Altura total</span>
                <strong>@FormatoMetros(Resultado?.AlturaTotal) m</strong>
            </div>

            <div class="tank3d-info__row">
                <span>Anillos</span>
                <strong>@(Resultado?.Anillos?.Count ?? 0)</strong>
            </div>

            <div class="tank3d-info__row">
                <span>Starter ring</span>
                <strong>
                    @(Resultado?.TieneStarterRing == true && Resultado.AlturaStarterRing > 0
                                        ? $"{FormatoNumero(Resultado.AlturaStarterRing)} mm"
                                        : "No")
                </strong>
            </div>

            <div class="tank3d-info__row">
                <span>Configuración</span>
                <strong>@TextoSeguro(Resultado?.NombreConfiguracionCalculada, Resultado?.NombreConfiguracion)</strong>
            </div>

            <div class="tank3d-info__row">
                <span>Material principal</span>
                <strong>@TextoSeguro(Resultado?.MaterialPrincipal)</strong>
            </div>

            <div class="tank3d-info__row">
                <span>Techo</span>
                <strong>@DetectarTecho()</strong>
            </div>

            @if (Resultado?.VigasTechoConico?.Aplica == true)
            {
                <div class="tank3d-info__row">
                    <span>Vigas radiales</span>
                    <strong>@NumeroVigas3D()</strong>
                </div>

                <div class="tank3d-info__row">
                    <span>Longitud viga</span>
                    <strong>@FormatoMetros(Resultado.VigasTechoConico.LongitudViga) m</strong>
                </div>

                <div class="tank3d-info__row">
                    <span>Ángulo techo</span>
                    <strong>@FormatoNumero(Resultado.VigasTechoConico.AnguloTechoGrados)°</strong>
                </div>

                <div class="tank3d-info__row">
                    <span>Perfil sugerido</span>
                    <strong>@Resultado.VigasTechoConico.PerfilSugerido</strong>
                </div>
            }

            <div class="tank3d-info__row">
                <span>Escalera</span>
                <strong>@DetectarEscalera().Tipo</strong>
            </div>

            <div class="tank3d-info__row">
                <span>Rigidizador</span>
                <strong>@TextoSeguro(Resultado?.NombreRigidizadorBase, "No encontrado")</strong>
            </div>

            <div class="tank3d-legend">
                <div class="tank3d-legend__title">Anillos calculados</div>

                @if (Resultado?.TieneStarterRing == true && Resultado.AlturaStarterRing > 0)
                {
                    <div class="tank3d-legend__item">
                        <span>Starter ring</span>
                        <strong>@FormatoNumero(Resultado.AlturaStarterRing) mm · anillo inferior</strong>
                    </div>
                }

                @foreach (var anillo in AnillosOrdenados())
                {
                    <div class="tank3d-legend__item">
                        <span>Anillo @anillo.NumeroAnillo</span>
                        <strong>
                            @TextoSeguro(anillo.MaterialAplicado, Resultado?.MaterialPrincipal)
                            · @FormatoNumero(anillo.EspesorSeleccionado) mm
                        </strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ResultadoCalculoModel? Resultado { get; set; }
    [Parameter] public object? Tanque { get; set; }
    [Parameter] public CargasModel? Cargas { get; set; }
    [Parameter] public InstalacionModel? Instalacion { get; set; }
    [Parameter] public object? Proyecto { get; set; }
    [Parameter] public EventCallback OnConfiguracion3DChanged { get; set; }

    private ElementReference _contenedor3d;
    private bool _renderInicialPendiente = true;
    private string? _mensaje;
    private DotNetObjectReference<Vista3D>? _dotNetRef;

    private int NumeroVigas3D()
    {
        return Cargas?.NumeroVigasTechoConico3D
            ?? Resultado?.VigasTechoConico?.NumeroVigas
            ?? 0;
    }

    [JSInvokable]
    public async Task ActualizarConfiguracionTecho3D(int numeroVigas, double factorNucleo)
    {
        if (Cargas is null)
            return;

        Cargas.NumeroVigasTechoConico3D = numeroVigas;
        Cargas.FactorNucleoTechoConico3D = factorNucleo;

        if (Resultado?.VigasTechoConico is not null)
            Resultado.VigasTechoConico.NumeroVigas = numeroVigas;

        if (OnConfiguracion3DChanged.HasDelegate)
            await OnConfiguracion3DChanged.InvokeAsync();

        StateHasChanged();
    }

    private sealed class Escalera3DInfo
    {
        public string Tipo { get; set; } = "Sin escalera";
        public int NumeroEscaleras { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && !_renderInicialPendiente)
            return;

        _renderInicialPendiente = false;
        await ActualizarVista3D();
    }

    protected override void OnParametersSet()
    {
        _renderInicialPendiente = true;
    }

    private async Task ActualizarVista3D()
    {
        try
        {
            _mensaje = null;

            if (!HayDatosSuficientes())
            {
                _mensaje = "Todavía no hay un resultado calculado válido con anillos para generar la vista 3D.";
                return;
            }

            _dotNetRef ??= DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "tank3d.renderTank3D",
                _contenedor3d,
                CrearDto3D(),
                _dotNetRef);
        }
        catch (Exception ex)
        {
            _mensaje = $"No se pudo cargar la vista 3D: {ex.Message}";
        }
    }

    private bool HayDatosSuficientes()
    {
        return Resultado is not null
            && Resultado.Diametro > 0
            && Resultado.AlturaTotal > 0
            && Resultado.Anillos is not null
            && Resultado.Anillos.Count > 0;
    }

    private object CrearDto3D()
    {
        var resultado = Resultado!;
        var escalera = DetectarEscalera();

        var anillos = AnillosOrdenadosParaModelo3D().Select(a => new
        {
            numero = a.NumeroAnillo,
            alturaInferior = a.AlturaInferior,
            alturaSuperior = a.AlturaSuperior,
            altura = Math.Max(0, a.AlturaSuperior - a.AlturaInferior),
            espesor = a.EspesorSeleccionado,
            material = TextoSeguro(a.MaterialAplicado, resultado.MaterialPrincipal),
            configuracion = TextoSeguro(a.ConfiguracionAplicada, resultado.NombreConfiguracionCalculada, resultado.NombreConfiguracion),
            valido = a.EsValido
        }).ToList();

        return new
        {
            diametro = resultado.Diametro,
            alturaTotal = resultado.AlturaTotal,
            materialPrincipal = TextoSeguro(resultado.MaterialPrincipal),
            configuracion = TextoSeguro(resultado.NombreConfiguracionCalculada, resultado.NombreConfiguracion),
            rigidizadorSuperior = TextoSeguro(resultado.NombreRigidizadorBase),
            techo = DetectarTecho(),

            tieneStarterRing = resultado.TieneStarterRing,
            alturaStarterRing = resultado.AlturaStarterRing,
            starterRingHeight = resultado.AlturaStarterRing,
            distanciaFStarterRing = resultado.DistanciaFStarterRing,
            shearKeysPorLineaStarterRing = resultado.ShearKeysPorLineaStarterRing,

            vigasTechoConico = resultado.VigasTechoConico is null
                ? null
                : new
                {
                    aplica = resultado.VigasTechoConico.Aplica,

                    numeroVigas = Cargas?.NumeroVigasTechoConico3D
                        ?? resultado.VigasTechoConico.NumeroVigas,

                    factorNucleo3D = Cargas?.FactorNucleoTechoConico3D
                        ?? 0.16,

                    anguloTechoGrados = resultado.VigasTechoConico.AnguloTechoGrados,
                    alturaCono = resultado.VigasTechoConico.AlturaCono,
                    longitudViga = resultado.VigasTechoConico.LongitudViga,
                    separacionPerimetral = resultado.VigasTechoConico.SeparacionPerimetral,
                    cargaPorViga = resultado.VigasTechoConico.CargaPorViga,
                    perfilSugerido = resultado.VigasTechoConico.PerfilSugerido
                },

            escalera = new
            {
                tipo = escalera.Tipo,
                numeroEscaleras = escalera.NumeroEscaleras
            },

            anillos
        };
    }

    private Escalera3DInfo DetectarEscalera()
    {
        var tipo = TextoSeguro(
            LeerPropiedad(Instalacion, "TipoEscalera"),
            LeerPropiedad(Instalacion, "Escalera"),
            LeerPropiedad(Instalacion, "TipoDeEscalera"),
            LeerPropiedad(Instalacion, "TipoEscaleraSeleccionada"));

        var numero = LeerEntero(Instalacion, "NumeroEscaleras");

        if (string.IsNullOrWhiteSpace(tipo) || tipo == "—")
            tipo = "Sin escalera";

        return new Escalera3DInfo
        {
            Tipo = tipo,
            NumeroEscaleras = numero
        };
    }

    private string DetectarTecho()
    {
        var fuentes = new object?[] { Cargas, Tanque, Instalacion, Proyecto };

        var nombresExactos = new[]
        {
            "TipoTecho", "Techo", "TipoCubierta", "Cubierta", "RoofType", "Roof",
            "TipoDeTecho", "TipoCubiertaSeleccionada", "TipoTechoSeleccionado"
        };

        foreach (var fuente in fuentes)
        {
            foreach (var nombre in nombresExactos)
            {
                var valor = LeerPropiedad(fuente, nombre);

                if (EsValorTechoValido(valor))
                    return valor!.Trim();
            }
        }

        foreach (var fuente in fuentes)
        {
            var valor =
                BuscarPropiedadQueContenga(fuente, "techo") ??
                BuscarPropiedadQueContenga(fuente, "cubierta") ??
                BuscarPropiedadQueContenga(fuente, "roof");

            if (EsValorTechoValido(valor))
                return valor!.Trim();
        }

        return "None";
    }

    private static bool EsValorTechoValido(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return false;

        var limpio = valor.Trim();

        if (limpio == "—")
            return false;

        return true;
    }

    private static string? LeerPropiedad(object? origen, string nombre)
    {
        if (origen is null)
            return null;

        var propiedad = origen.GetType().GetProperty(nombre);

        if (propiedad is null)
            return null;

        return propiedad.GetValue(origen)?.ToString();
    }

    private static int LeerEntero(object? origen, string nombre)
    {
        if (origen is null)
            return 0;

        var propiedad = origen.GetType().GetProperty(nombre);

        if (propiedad is null)
            return 0;

        var valor = propiedad.GetValue(origen);

        if (valor is null)
            return 0;

        return int.TryParse(valor.ToString(), out var numero) ? numero : 0;
    }

    private static string? BuscarPropiedadQueContenga(object? origen, string texto)
    {
        if (origen is null)
            return null;

        foreach (var propiedad in origen.GetType().GetProperties())
        {
            if (!propiedad.Name.Contains(texto, StringComparison.OrdinalIgnoreCase))
                continue;

            var valor = propiedad.GetValue(origen)?.ToString();

            if (EsValorTechoValido(valor))
                return valor;
        }

        return null;
    }

    private List<ResultadoAnilloModel> AnillosOrdenados()
    {
        return Resultado?.Anillos?
            .OrderBy(a => a.NumeroAnillo)
            .ToList() ?? new List<ResultadoAnilloModel>();
    }

    private List<ResultadoAnilloModel> AnillosOrdenadosParaModelo3D()
    {
        return Resultado?.Anillos?
            .OrderByDescending(a => a.AlturaInferior)
            .ThenByDescending(a => a.AlturaSuperior)
            .ThenByDescending(a => a.NumeroAnillo)
            .ToList() ?? new List<ResultadoAnilloModel>();
    }

    private static string TextoSeguro(params string?[] valores)
    {
        foreach (var valor in valores)
        {
            if (!string.IsNullOrWhiteSpace(valor))
                return valor.Trim();
        }

        return "—";
    }

    private static string FormatoNumero(double? valor)
    {
        if (!valor.HasValue || valor.Value <= 0)
            return "—";

        return valor.Value.ToString("0.###", System.Globalization.CultureInfo.CurrentCulture);
    }

    private static string FormatoMetros(double? valor)
    {
        if (!valor.HasValue || valor.Value <= 0)
            return "—";

        var metros = valor.Value > 100 ? valor.Value / 1000.0 : valor.Value;

        return metros.ToString("0.###", System.Globalization.CultureInfo.CurrentCulture);
    }

    public ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}